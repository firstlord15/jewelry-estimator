# Шаблон без секретов: .env.example

# --- Django ---
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.192
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- PostgreSQL (для docker-compose) ---
POSTGRES_DB=muras_gold
POSTGRES_USER=muras_gold
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
DATABASE_URL=postgres://muras_gold:change-me@127.0.0.1:5434/muras_gold

# --- Хранилище фото ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# --- Telegram (уведомления о заказах) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Сайт ---
SITE_NAME=Muras Store
# Адрес сайта без слэша в конце: для ссылок в письмах и сообщениях Telegram
SITE_URL=http://127.0.0.1:8000

# --- Языки и время ---
# Языки сайта: ru, ky, en. Язык по умолчанию без префикса в адресе не задаётся (префикс всегда: /ru/, /ky/, /en/)
LANGUAGE_CODE=ru
TIME_ZONE=Asia/Bishkek

# --- Калькулятор ---
CALC_SHOW_QUANTITY=False

# --- Почта (регистрация, сброс пароля) ---
# В разработке письма печатаются в консоль. Для реальной отправки заменить на
# django.core.mail.backends.smtp.EmailBackend и заполнить данные SMTP ниже
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Gold Store <noreply@example.com>

# --- Безопасность ---
# Для продакшена (DEBUG=False, HTTPS): SECURE_SSL_REDIRECT=True, SESSION_COOKIE_SECURE=True,
# CSRF_COOKIE_SECURE=True, SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
# Адрес админки: в продакшене лучше заменить, например, на manage-x7k2/
ADMIN_URL=admin/

# --- Лимиты ---
# Максимальный размер загружаемого фото, МБ
MAX_UPLOAD_MB=10
# Сколько заказов можно оформить с одного адреса за час (защита от спама при заказе без входа)
ORDERS_PER_HOUR=5

# --- Логи ---
LOG_LEVEL=INFO
