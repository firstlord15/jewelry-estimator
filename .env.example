# Шаблон без секретов: .env.example

# --- Django ---
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.192
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- PostgreSQL (для docker-compose) ---
POSTGRES_DB=gold_store
POSTGRES_USER=gold_store
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgres://gold_store:change-me@127.0.0.1:5434/gold_store

# --- Хранилище фото ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# --- Telegram (уведомления о заказах) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
